{
  "name": "chess-coach",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n server,web \"tsx watch server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:content": "tsx scripts/validate-content.ts",
    "smoke:start": "bash scripts/smoke-server.sh",
    "smoke:stop": "bash scripts/smoke-stop.sh"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^2.1.5",
    "chess.js": "^1.4.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
